.local_sync_broker.sqlite3
.local_sync_broker.sqlite3-shm
.local_sync_broker.sqlite3-wal
.local_sync_broker.sqlite3.plaintext-backup-*
.local_sync_broker.sqlite3.encrypted-tmp-*

