.env
.env.*
!.env.example
.secrets/

# ShotGrid local cache
.shotgrid_cache.json
.shotgrid_cache.json.tmp

# Internal docs (not public yet)
docs/

# Tool artifacts
.codex/*
!.codex/skills/
.codex/skills/*
