# =============================================================================
# ShotGrid Live Sync (Optional)
# =============================================================================
#
# Run the local proxy server:
#   python3 server/shotgrid_server.py
#
# Option A (Recommended): Studio script credentials (service account)
#
# Note: This is the easiest setup for "anyone" on the team - users won't have to
# enter personal credentials into this app.

SHOTGRID_URL=https://your-studio.shotgrid.autodesk.com
SHOTGRID_SCRIPT_NAME=
SHOTGRID_API_KEY=

# Option B: Personal sign-in (no script)
#
# No env vars needed - users will sign in in the UI. Setting SHOTGRID_URL above
# is still recommended to pre-fill the "Site URL" field.

# Optional: default project id if you don't pick one in the UI.
SHOTGRID_PROJECT_ID=

# Local broker DB encryption (SQLCipher)
#
# Default behavior (recommended):
# - AUTO encryption is ON.
# - Server auto-generates + stores a managed key per user.
# - Existing plaintext DB auto-migrates to encrypted format.
#
# Install once:
#   python3 -m pip install sqlcipher3
#
# Optional overrides:
# LOCAL_BROKER_AUTO_ENCRYPTION=1
# LOCAL_BROKER_MANAGED_KEY_FILE=~/.config/uptospeed/local_broker.key
# LOCAL_BROKER_MANAGED_KEY_DIR=~/.config/uptospeed
#
# Optional explicit key sources (override managed key):
# LOCAL_BROKER_ENCRYPTION_KEY=
# LOCAL_BROKER_ENCRYPTION_KEY_FILE=.secrets/local-broker.key
#
# Optional hard requirement (fail fast if no key is available):
# LOCAL_BROKER_ENCRYPTION_REQUIRED=1
#
# Auto-migrate existing plaintext DB to encrypted on startup (default: 1):
# LOCAL_BROKER_AUTO_MIGRATE_PLAINTEXT=1

# Optional/custom fields (only set these if your ShotGrid has them):
# SHOTGRID_FIELD_DEPT_PROD_NOTE=
# SHOTGRID_FIELD_TARGET_STATUS_SUMMARY=
# SHOTGRID_FIELD_TASK_COMMENTS=

# Cache TTL in seconds (default: 300). Set 0 to disable.
# SHOTGRID_CACHE_TTL_SECONDS=300

# Debug logging (prints upstream ShotGrid errors + payloads)
# SHOTGRID_DEBUG=1
